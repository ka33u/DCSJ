# Read by Docker Compose. For python run.py, set these in your shell environment.
DCSJ_DATA_DIR=/app/.runtime
# Optional: one-click import from a private repository. Never commit a real token.
DCSJ_RESOURCE_REPOSITORY=ka33u/DCSJ-SYSJ
DCSJ_RESOURCE_REF=main
DCSJ_RESOURCE_TOKEN=
# For native Python deployment, alternatively set DCSJ_RESOURCE_TOKEN_FILE to a
# protected file path. Container use requires mounting that file read-only and
# setting the path inside the container in a private Compose override.
